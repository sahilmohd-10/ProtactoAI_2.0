# Protector AI 2.0 — Backend Configuration Example
# Copy this file to .env and supply your credentials

# Flask Environment
FLASK_ENV=development
PORT=5000

# Firebase Authentication (Admin SDK)
FIREBASE_PROJECT_ID=protectoai-8a951
# Optional: Path to Firebase Service Account JSON key file (downloaded from Firebase Console)
# FIREBASE_SERVICE_ACCOUNT_KEY=data/serviceAccountKey.json

# OAuth Configuration (Google & GitHub)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# Transactional Email APIs (HTTPS Port 443)
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM=Protector AI <onboarding@resend.dev>

# Optional: Brevo / Mailercloud HTTPS API Key
# BREVO_API_KEY=your_brevo_api_key
# MAILERCLOUD_API_KEY=your_mailercloud_api_key
# MAILERCLOUD_FROM=protectoaismvdu@gmail.com
